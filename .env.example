# Site
NEXT_PUBLIC_SITE_URL=https://kaleidosparkhq.com
NEXT_PUBLIC_PORTAL_URL=https://app.kaleidosparkhq.com

# Neon Postgres (Vercel Neon integration or neon.tech free tier)
DATABASE_URL=

# Auth.js — Google SSO for /admin only
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowlist of admin emails
ADMIN_EMAILS=

# Resend (form notifications + newsletter confirm)
RESEND_API_KEY=
RESEND_FROM_EMAIL=KaleidoSpark <hello@kaleidosparkhq.com>
LEAD_NOTIFY_EMAIL=kaleidospark@icloud.com

# Cloudflare Turnstile (spam protection — optional; skipped when unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional CRM webhook (Zapier / Make)
CRM_WEBHOOK_URL=

# Keystatic local storage is default; set for GitHub storage later if needed
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
